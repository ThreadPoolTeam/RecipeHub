# RecipeHub Environment Variables Template (Placeholders Only)
# Defaults in infra/compose.yaml are dev-only; replace every value below outside local development.

# PostgreSQL Configuration (cluster superuser: only used by Postgres init, never by services)
POSTGRES_USER=recipehub_admin
POSTGRES_PASSWORD=your_secure_admin_password
POSTGRES_DB=recipehub_default

# Database-per-service Credentials
# *_MIGRATOR_*: owns the DB, runs DDL + seed at first init (never used by services)
# *_DB_USER:    runtime account used by the service (CONNECT + DML only, no DDL)
IDENTITY_MIGRATOR_USER=identity_migrator
IDENTITY_MIGRATOR_PASSWORD=your_secure_identity_migrator_password
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=your_secure_identity_password
IDENTITY_DB_NAME=recipehub_identity

RECIPE_MIGRATOR_USER=recipe_migrator
RECIPE_MIGRATOR_PASSWORD=your_secure_recipe_migrator_password
RECIPE_DB_USER=recipe_user
RECIPE_DB_PASSWORD=your_secure_recipe_password
RECIPE_DB_NAME=recipehub_recipe

CONTENT_MIGRATOR_USER=content_migrator
CONTENT_MIGRATOR_PASSWORD=your_secure_content_migrator_password
CONTENT_DB_USER=content_user
CONTENT_DB_PASSWORD=your_secure_content_password
CONTENT_DB_NAME=recipehub_content

AUDIT_MIGRATOR_USER=audit_migrator
AUDIT_MIGRATOR_PASSWORD=your_secure_audit_migrator_password
AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=your_secure_audit_password
AUDIT_DB_NAME=recipehub_audit

QUIZ_MIGRATOR_USER=quiz_migrator
QUIZ_MIGRATOR_PASSWORD=your_secure_quiz_migrator_password
QUIZ_DB_USER=quiz_user
QUIZ_DB_PASSWORD=your_secure_quiz_password
QUIZ_DB_NAME=recipehub_quiz

# Postgres role: SELECT for Grafana datasources + pg_monitor for postgres-exporter
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=your_secure_grafana_reader_password

# Infrastructure Port Mappings
REDIS_PORT=6379
GATEWAY_PORT=5000
FRONTEND_PORT=3000
QUIZ_PORT=5005

# JWT signing key for Identity (>= 32 bytes); compose falls back to a dev-only key when unset
JWT_SIGNING_KEY=your_secure_jwt_signing_key_at_least_32_bytes

# Observability & DB Management Tools (pgAdmin and Grafana bind to 127.0.0.1 only)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@recipehub.vn
PGADMIN_PASSWORD=admin123
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# AI image generation (Content API + background worker)
# Required for real AI images; multiple Gemini keys can be comma-separated.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Permanent media and PDF storage (Content API + Recipe API)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
