FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY BuildingBlocks/ ./BuildingBlocks/
COPY Contracts/ ./Contracts/
COPY Gateway/ ./Gateway/

RUN dotnet restore Gateway/RecipeHub.Gateway/RecipeHub.Gateway.csproj
RUN dotnet publish Gateway/RecipeHub.Gateway/RecipeHub.Gateway.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:5000
EXPOSE 5000
ENTRYPOINT ["dotnet", "RecipeHub.Gateway.dll"]
