{
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "ClientId": "identity-service",
    "AuditTopic": "recipehub.audit.activities.v1",
    "AuditDlqTopic": "recipehub.audit.activities.v1.dlq",
    "AuditConsumerGroup": "recipehub-audit",
    "MaxDeliveryAttempts": 3,
    "ProduceTimeoutMs": 3000
  },
  "Messaging": {
    "AuditTransport": "Kafka"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
