CREATE SCHEMA IF NOT EXISTS "quiz_db";

CREATE TABLE "quiz_db"."quiz" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "code" text UNIQUE NOT NULL,
  "title" text NOT NULL,
  "description" text,
  "created_by_user_ref" uuid NOT NULL,
  "next_version_number" integer NOT NULL DEFAULT 1,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "quiz_code_check" CHECK (length(btrim(code)) > 0),
  CONSTRAINT "quiz_title_check" CHECK (length(btrim(title)) > 0),
  CONSTRAINT "quiz_next_version_number_check" CHECK (next_version_number > 0)
);

CREATE TABLE "quiz_db"."quiz_version" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "quiz_id" bigint NOT NULL,
  "version_number" integer NOT NULL DEFAULT 1,
  "recipe_version_ref" uuid NOT NULL,
  "passing_score" numeric(5,2) NOT NULL DEFAULT 80.0,
  "state" text NOT NULL DEFAULT 'draft',
  "created_by_user_ref" uuid NOT NULL,
  "published_at" timestamptz,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "quiz_version_number_check" CHECK (version_number > 0),
  CONSTRAINT "quiz_version_passing_score_check" CHECK (passing_score > 0 AND passing_score <= 100),
  CONSTRAINT "quiz_version_state_check" CHECK (state IN ('draft', 'published', 'archived')),
  CONSTRAINT "quiz_version_published_check" CHECK ((state = 'draft' AND published_at IS NULL) OR (state IN ('published', 'archived') AND published_at IS NOT NULL))
);

CREATE TABLE "quiz_db"."quiz_question" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "quiz_version_id" bigint NOT NULL,
  "sort_order" integer NOT NULL DEFAULT 1,
  "content" text NOT NULL,
  "explanation" text,
  CONSTRAINT "quiz_question_sort_order_check" CHECK (sort_order > 0),
  CONSTRAINT "quiz_question_content_check" CHECK (length(btrim(content)) > 0)
);

CREATE TABLE "quiz_db"."quiz_option" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "question_id" bigint NOT NULL,
  "sort_order" integer NOT NULL DEFAULT 1,
  "content" text NOT NULL,
  "is_correct" boolean NOT NULL DEFAULT false,
  CONSTRAINT "quiz_option_sort_order_check" CHECK (sort_order > 0),
  CONSTRAINT "quiz_option_content_check" CHECK (length(btrim(content)) > 0)
);

CREATE TABLE "quiz_db"."quiz_attempt" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "quiz_version_id" bigint NOT NULL,
  "user_ref" uuid NOT NULL,
  "state" text NOT NULL DEFAULT 'in_progress',
  "score" numeric(5,2),
  "is_passed" boolean,
  "started_at" timestamptz NOT NULL DEFAULT (now()),
  "submitted_at" timestamptz,
  CONSTRAINT "quiz_attempt_state_check" CHECK (state IN ('in_progress', 'submitted')),
  CONSTRAINT "quiz_attempt_submission_check" CHECK (
    (state = 'in_progress' AND score IS NULL AND submitted_at IS NULL AND is_passed IS NULL) OR
    (state = 'submitted' AND score IS NOT NULL AND submitted_at IS NOT NULL AND is_passed IS NOT NULL AND submitted_at >= started_at)
  ),
  CONSTRAINT "quiz_attempt_score_range_check" CHECK (score IS NULL OR (score >= 0.0 AND score <= 100.0))
);

CREATE TABLE "quiz_db"."quiz_answer" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "attempt_id" bigint NOT NULL,
  "question_id" bigint NOT NULL,
  "selected_option_id" bigint
);

-- Indexes
CREATE UNIQUE INDEX "quiz_version_number_uidx" ON "quiz_db"."quiz_version" ("quiz_id", "version_number");
CREATE INDEX "quiz_version_recipe_ref_idx" ON "quiz_db"."quiz_version" ("recipe_version_ref");
CREATE INDEX "quiz_version_state_idx" ON "quiz_db"."quiz_version" ("state");

CREATE INDEX "quiz_question_version_order_idx" ON "quiz_db"."quiz_question" ("quiz_version_id", "sort_order");
CREATE INDEX "quiz_option_question_order_idx" ON "quiz_db"."quiz_option" ("question_id", "sort_order");

CREATE INDEX "quiz_attempt_user_version_idx" ON "quiz_db"."quiz_attempt" ("user_ref", "quiz_version_id");
CREATE INDEX "quiz_attempt_state_idx" ON "quiz_db"."quiz_attempt" ("state");
CREATE UNIQUE INDEX "quiz_attempt_in_progress_uidx" ON "quiz_db"."quiz_attempt" ("user_ref", "quiz_version_id") WHERE state = 'in_progress';

CREATE UNIQUE INDEX "quiz_answer_attempt_question_uidx" ON "quiz_db"."quiz_answer" ("attempt_id", "question_id");
CREATE INDEX "quiz_answer_option_idx" ON "quiz_db"."quiz_answer" ("selected_option_id");

-- Foreign Keys (Ràng buộc nội bộ quiz_db, không FK xuyên database)
ALTER TABLE "quiz_db"."quiz_version" ADD CONSTRAINT "fk_quiz_version_quiz" FOREIGN KEY ("quiz_id") REFERENCES "quiz_db"."quiz" ("id") ON DELETE RESTRICT;
ALTER TABLE "quiz_db"."quiz_question" ADD CONSTRAINT "fk_quiz_question_version" FOREIGN KEY ("quiz_version_id") REFERENCES "quiz_db"."quiz_version" ("id") ON DELETE RESTRICT;
ALTER TABLE "quiz_db"."quiz_option" ADD CONSTRAINT "fk_quiz_option_question" FOREIGN KEY ("question_id") REFERENCES "quiz_db"."quiz_question" ("id") ON DELETE RESTRICT;
ALTER TABLE "quiz_db"."quiz_attempt" ADD CONSTRAINT "fk_quiz_attempt_version" FOREIGN KEY ("quiz_version_id") REFERENCES "quiz_db"."quiz_version" ("id") ON DELETE RESTRICT;
ALTER TABLE "quiz_db"."quiz_answer" ADD CONSTRAINT "fk_quiz_answer_attempt" FOREIGN KEY ("attempt_id") REFERENCES "quiz_db"."quiz_attempt" ("id") ON DELETE RESTRICT;
ALTER TABLE "quiz_db"."quiz_answer" ADD CONSTRAINT "fk_quiz_answer_question" FOREIGN KEY ("question_id") REFERENCES "quiz_db"."quiz_question" ("id") ON DELETE RESTRICT;
ALTER TABLE "quiz_db"."quiz_answer" ADD CONSTRAINT "fk_quiz_answer_option" FOREIGN KEY ("selected_option_id") REFERENCES "quiz_db"."quiz_option" ("id") ON DELETE RESTRICT;
