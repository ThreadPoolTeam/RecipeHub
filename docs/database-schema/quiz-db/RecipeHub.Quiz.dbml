Project RecipeHubQuizDatabase {
  database_type: 'PostgreSQL'
  Note: 'Quiz Service; quản lý đề kiểm tra và lịch sử làm bài của Barista/Viewer theo phiên bản công thức. Không tạo FK vật lý xuyên database.'
}

Table quiz_db.quiz {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'ID công khai của bài quiz']
  code text [not null, unique, note: 'Mã quiz (ví dụ QUIZ-MATCHA-001)']
  title text [not null]
  description text
  created_by_user_ref uuid [not null, note: 'Soft ref tới Identity.users']
  next_version_number int [not null, default: 1, note: 'Bộ đếm số bản tiếp theo của đề, tăng dần không tái sử dụng']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `length(btrim(code)) > 0` [name: 'quiz_code_check']
    `length(btrim(title)) > 0` [name: 'quiz_title_check']
    `next_version_number > 0` [name: 'quiz_next_version_number_check']
  }

  Note: 'Thực thể gốc định danh đề kiểm tra; một Quiz có thể có nhiều QuizVersion theo thời gian.'
}

Table quiz_db.quiz_version {
  id bigint [pk, increment]
  public_id uuid [not null, unique]
  quiz_id bigint [not null]
  version_number int [not null, default: 1]
  recipe_version_ref uuid [not null, note: 'Soft ref tới Recipe.recipe_version đã duyệt']
  passing_score numeric(5,2) [not null, default: 80.0, note: 'Ngưỡng đạt (%), mặc định 80%']
  state text [not null, default: 'draft', note: 'draft | published | archived']
  created_by_user_ref uuid [not null]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (quiz_id, version_number) [unique, name: 'quiz_version_number_uidx']
    recipe_version_ref [name: 'quiz_version_recipe_ref_idx']
    state [name: 'quiz_version_state_idx']
  }

  checks {
    `version_number > 0` [name: 'quiz_version_number_check']
    `passing_score > 0 AND passing_score <= 100` [name: 'quiz_version_passing_score_check']
    `state IN ('draft', 'published', 'archived')` [name: 'quiz_version_state_check']
    `(state = 'draft' AND published_at IS NULL) OR (state IN ('published', 'archived') AND published_at IS NOT NULL)` [name: 'quiz_version_published_check']
  }

  Note: 'Phiên bản đề gắn cố định với 1 RecipeVersion; đề đã ban hành là bất biến, thay đổi phải tạo version mới.'
}

Table quiz_db.quiz_question {
  id bigint [pk, increment]
  quiz_version_id bigint [not null]
  sort_order int [not null, default: 1]
  content text [not null, note: 'Nội dung câu hỏi trắc nghiệm']
  explanation text [note: 'Giải thích đáp án (chỉ hiện sau khi nộp bài)']

  indexes {
    (quiz_version_id, sort_order) [name: 'quiz_question_version_order_idx']
  }

  checks {
    `sort_order > 0` [name: 'quiz_question_sort_order_check']
    `length(btrim(content)) > 0` [name: 'quiz_question_content_check']
  }
}

Table quiz_db.quiz_option {
  id bigint [pk, increment]
  question_id bigint [not null]
  sort_order int [not null, default: 1]
  content text [not null, note: 'Nội dung lựa chọn (A, B, C, D...)']
  is_correct boolean [not null, default: false, note: 'Đánh dấu đáp án đúng; chỉ Admin/chấm điểm được đọc']

  indexes {
    (question_id, sort_order) [name: 'quiz_option_question_order_idx']
  }

  checks {
    `sort_order > 0` [name: 'quiz_option_sort_order_check']
    `length(btrim(content)) > 0` [name: 'quiz_option_content_check']
  }
}

Table quiz_db.quiz_attempt {
  id bigint [pk, increment]
  public_id uuid [not null, unique]
  quiz_version_id bigint [not null]
  user_ref uuid [not null, note: 'Soft ref tới Identity.users (Viewer làm bài)']
  state text [not null, default: 'in_progress', note: 'in_progress | submitted']
  score numeric(5,2) [note: 'Điểm số % (NULL khi in_progress, có giá trị khi submitted)']
  is_passed boolean [note: 'NULL khi in_progress, true/false khi submitted']
  started_at timestamptz [not null, default: `now()`]
  submitted_at timestamptz [note: 'NULL khi in_progress, ghi nhận lúc nộp']

  indexes {
    (user_ref, quiz_version_id) [name: 'quiz_attempt_user_version_idx']
    state [name: 'quiz_attempt_state_idx']
    (user_ref, quiz_version_id) [name: 'quiz_attempt_in_progress_uidx', note: 'unique partial index WHERE state = in_progress']
  }

  checks {
    `state IN ('in_progress', 'submitted')` [name: 'quiz_attempt_state_check']
    `(state = 'in_progress' AND score IS NULL AND submitted_at IS NULL AND is_passed IS NULL) OR (state = 'submitted' AND score IS NOT NULL AND submitted_at IS NOT NULL AND is_passed IS NOT NULL AND submitted_at >= started_at)` [name: 'quiz_attempt_submission_check']
    `score IS NULL OR (score >= 0.0 AND score <= 100.0)` [name: 'quiz_attempt_score_range_check']
  }

  Note: 'Lưu lịch sử từng lần làm bài của Viewer; không xóa hoặc sửa bài đã nộp.'
}

Table quiz_db.quiz_answer {
  id bigint [pk, increment]
  attempt_id bigint [not null]
  question_id bigint [not null]
  selected_option_id bigint [note: 'Lựa chọn thí sinh đã tick; NULL nếu bỏ trống']

  indexes {
    (attempt_id, question_id) [unique, name: 'quiz_answer_attempt_question_uidx']
    selected_option_id [name: 'quiz_answer_option_idx']
  }

  Note: 'Chi tiết từng câu trả lời của lượt thi để chấm điểm và đối chiếu lịch sử.'
}

Ref: quiz_db.quiz_version.quiz_id > quiz_db.quiz.id [delete: restrict]
Ref: quiz_db.quiz_question.quiz_version_id > quiz_db.quiz_version.id [delete: restrict]
Ref: quiz_db.quiz_option.question_id > quiz_db.quiz_question.id [delete: restrict]
Ref: quiz_db.quiz_attempt.quiz_version_id > quiz_db.quiz_version.id [delete: restrict]
Ref: quiz_db.quiz_answer.attempt_id > quiz_db.quiz_attempt.id [delete: restrict]
Ref: quiz_db.quiz_answer.question_id > quiz_db.quiz_question.id [delete: restrict]
Ref: quiz_db.quiz_answer.selected_option_id > quiz_db.quiz_option.id [delete: restrict]
