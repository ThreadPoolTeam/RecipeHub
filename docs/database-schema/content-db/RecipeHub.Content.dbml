Project RecipeHubContentDatabase {
  database_type: 'PostgreSQL'
  Note: 'Thiết kế Content Service tinh gọn: gen ảnh thành phẩm hoặc ảnh bước, preview 30 phút, duyệt ảnh lưu Cloudinary và transactional outbox đẩy Redis Streams.'
}

Table content_db.ai_image_draft {
  id bigint [pk, increment]
  public_id uuid [not null, unique]
  recipe_version_ref uuid [not null, note: 'RecipeVersion public_id từ Recipe Service; không tạo FK xuyên database.']
  recipe_step_ref uuid [note: 'RecipeStep public_id; bắt buộc cho step_instruction, phải rỗng cho final_product.']
  target_kind text [not null, note: 'final_product hoặc step_instruction.']
  user_brief text
  input_snapshot jsonb [not null, note: 'Snapshot JSON context công thức/bước tại thời điểm enqueue.']
  prompt_snapshot text [note: 'Prompt tiếng Anh gửi image provider; NULL khi queued/processing trước LLM, bắt buộc khi generated/accepted.']
  provider text [not null, default: 'CloudflareSchnell', note: 'Nhà cung cấp gen ảnh: CloudflareSchnell.']
  model text [not null, default: '@cf/black-forest-labs/flux-1-schnell']
  geometry_mode text [not null, default: 'native', note: 'FLUX Schnell native resolution; không nhận aspect_ratio tùy ý từ client.']
  width integer [note: 'Kích thước pixel thực tế của ảnh.']
  height integer [note: 'Kích thước pixel thực tế của ảnh.']
  state text [not null, default: 'queued', note: 'queued | processing | generated | failed | accepting | accepted | discarded | expired.']
  temporary_image_path text [note: 'Đường dẫn tương đối trong kho file tạm dùng chung API/worker; NULL khi chưa có ảnh hoặc đã dọn xong.']
  mime_type text [note: 'MIME type: image/png, image/jpeg, image/webp.']
  byte_size bigint [note: 'Dung lượng bytes của file tạm.']
  error_code text [note: 'Mã lỗi máy đọc được.']
  error_message text [note: 'Thông báo lỗi đã lọc bí mật.']
  attempt_count integer [not null, default: 0]
  lease_token uuid [note: 'Token phân quyền worker lease hoặc accept lease chống ghi đè kết quả.']
  lease_expires_at timestamptz [note: 'Hạn lease ngăn chặn worker cũ ghi đè.']
  created_by_user_ref uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  generated_at timestamptz
  expires_at timestamptz [note: 'Hạn duyệt 30 phút tính từ generated_at.']
  decided_at timestamptz
  decided_by_user_ref uuid

  indexes {
    (recipe_version_ref, target_kind) [name: 'ai_image_draft_recipe_target_idx']
    recipe_step_ref [name: 'ai_image_draft_step_idx']
    (state, expires_at) [name: 'ai_image_draft_cleanup_idx']
    (created_by_user_ref, created_at) [name: 'ai_image_draft_creator_idx']
    (state, lease_expires_at) [name: 'ai_image_draft_worker_lease_idx']
  }

  checks {
    `target_kind IN ('final_product', 'step_instruction')` [name: 'ai_image_draft_target_kind_check']
    `(target_kind = 'final_product' AND recipe_step_ref IS NULL) OR (target_kind = 'step_instruction' AND recipe_step_ref IS NOT NULL)` [name: 'ai_image_draft_target_reference_check']
    `state IN ('queued', 'processing', 'generated', 'failed', 'accepting', 'accepted', 'discarded', 'expired')` [name: 'ai_image_draft_state_check']
    `geometry_mode = 'native'` [name: 'ai_image_draft_geometry_mode_check']
    `(generated_at IS NULL AND expires_at IS NULL) OR (generated_at IS NOT NULL AND expires_at IS NOT NULL AND expires_at > generated_at)` [name: 'ai_image_draft_expiry_check']
    `state NOT IN ('generated', 'accepting', 'accepted', 'expired') OR (generated_at IS NOT NULL AND expires_at IS NOT NULL AND prompt_snapshot IS NOT NULL)` [name: 'ai_image_draft_generated_time_check']
    `state NOT IN ('generated', 'accepting') OR (temporary_image_path IS NOT NULL AND width > 0 AND height > 0 AND byte_size > 0)` [name: 'ai_image_draft_generated_file_check']
    `state NOT IN ('accepted', 'discarded') OR (decided_at IS NOT NULL AND decided_by_user_ref IS NOT NULL)` [name: 'ai_image_draft_decision_check']
  }

  Note: 'Bản ghi giữ lịch sử tác vụ và quyết định sau Accept/Discard; chỉ file tạm được dọn. Trạng thái accepting giữ lease ngăn race giữa Cloudinary upload và cleanup/discard. input_snapshot lưu ngay khi enqueue; prompt_snapshot lưu sau LLM.'
}

Table content_db.media_asset {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'ID công khai dùng cho media_asset_ref phía Recipe Service.']
  ai_image_draft_id bigint [unique, note: 'NULL cho ảnh upload thủ công; một draft tối đa tạo một asset.']
  storage_provider text [not null, default: 'Cloudinary']
  provider_public_id text [not null, note: 'Cloudinary public ID, dùng quản lý/xóa ảnh; không phải đường dẫn local.']
  delivery_url text [not null, note: 'URL HTTPS hiển thị ảnh.']
  original_file_name text
  mime_type text [not null]
  byte_size bigint [not null]
  width integer [not null]
  height integer [not null]
  source_type text [not null, note: 'real hoặc ai_illustration.']
  state text [not null, default: 'active', note: 'active. Các trạng thái delete bị loại bỏ vì tính năng DELETE bị hoãn theo R5 gate.']
  created_by_user_ref uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (storage_provider, provider_public_id) [unique, name: 'media_asset_provider_public_id_uidx']
    (source_type, state, created_at) [name: 'media_asset_library_idx']
    created_by_user_ref [name: 'media_asset_creator_idx']
  }

  checks {
    `byte_size > 0` [name: 'media_asset_byte_size_check']
    `width > 0 AND height > 0` [name: 'media_asset_dimensions_check']
    `source_type IN ('real', 'ai_illustration')` [name: 'media_asset_source_type_check']
    `state = 'active'` [name: 'media_asset_state_check']
    `(source_type = 'real' AND ai_image_draft_id IS NULL) OR (source_type = 'ai_illustration' AND ai_image_draft_id IS NOT NULL)` [name: 'media_asset_ai_origin_check']
  }

  Note: 'Ảnh chính thức sau Accept hoặc upload thủ công. Metadata và file Cloudinary được lưu bền vững. Vị trí sử dụng do Recipe DB quản lý.'
}

Table content_db.outbox_message {
  id uuid [pk]
  event_type text [not null, note: 'Tên sự kiện: Content.ImageDraftQueued, Content.MediaAssetAccepted, v.v.']
  payload jsonb [not null, note: 'Dữ liệu sự kiện JSON serialize.']
  created_at timestamptz [not null, default: `now()`]
  processed_at timestamptz [note: 'NULL khi chưa publish sang Redis Streams; lưu timestamp khi đã XADD thành công.']
  retry_count integer [not null, default: 0]
  error text [note: 'Lỗi gần nhất nếu relay gặp sự cố.']

  indexes {
    (processed_at, created_at) [name: 'outbox_pending_idx']
  }

  Note: 'Transactional Outbox bảo vệ tính nhất quán dữ liệu giữa PostgreSQL và Redis Streams; commit cùng transaction với draft/asset.'
}

Ref media_asset_ai_draft: content_db.media_asset.ai_image_draft_id > content_db.ai_image_draft.id [delete: restrict]
