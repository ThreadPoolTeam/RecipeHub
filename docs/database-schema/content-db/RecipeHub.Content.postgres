CREATE SCHEMA "content_db";

CREATE TABLE "content_db"."ai_image_draft" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "recipe_version_ref" uuid NOT NULL,
  "recipe_step_ref" uuid,
  "target_kind" text NOT NULL,
  "user_brief" text,
  "input_snapshot" jsonb NOT NULL,
  "prompt_snapshot" text,
  "provider" text NOT NULL DEFAULT 'CloudflareSchnell',
  "model" text NOT NULL DEFAULT '@cf/black-forest-labs/flux-1-schnell',
  "geometry_mode" text NOT NULL DEFAULT 'native',
  "width" integer,
  "height" integer,
  "state" text NOT NULL DEFAULT 'queued',
  "temporary_image_path" text,
  "mime_type" text,
  "byte_size" bigint,
  "error_code" text,
  "error_message" text,
  "attempt_count" integer NOT NULL DEFAULT 0,
  "lease_token" uuid,
  "lease_expires_at" timestamptz,
  "created_by_user_ref" uuid NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "generated_at" timestamptz,
  "expires_at" timestamptz,
  "decided_at" timestamptz,
  "decided_by_user_ref" uuid,
  CONSTRAINT "ai_image_draft_target_kind_check" CHECK (target_kind IN ('final_product', 'step_instruction')),
  CONSTRAINT "ai_image_draft_target_reference_check" CHECK ((target_kind = 'final_product' AND recipe_step_ref IS NULL) OR (target_kind = 'step_instruction' AND recipe_step_ref IS NOT NULL)),
  CONSTRAINT "ai_image_draft_state_check" CHECK (state IN ('queued', 'processing', 'generated', 'failed', 'accepting', 'accepted', 'discarded', 'expired')),
  CONSTRAINT "ai_image_draft_geometry_mode_check" CHECK (geometry_mode = 'native'),
  CONSTRAINT "ai_image_draft_expiry_check" CHECK ((generated_at IS NULL AND expires_at IS NULL) OR (generated_at IS NOT NULL AND expires_at IS NOT NULL AND expires_at > generated_at)),
  CONSTRAINT "ai_image_draft_generated_time_check" CHECK (state NOT IN ('generated', 'accepting', 'accepted', 'expired') OR (generated_at IS NOT NULL AND expires_at IS NOT NULL AND prompt_snapshot IS NOT NULL)),
  CONSTRAINT "ai_image_draft_generated_file_check" CHECK (state NOT IN ('generated', 'accepting') OR (temporary_image_path IS NOT NULL AND width > 0 AND height > 0 AND byte_size > 0)),
  CONSTRAINT "ai_image_draft_decision_check" CHECK (state NOT IN ('accepted', 'discarded') OR (decided_at IS NOT NULL AND decided_by_user_ref IS NOT NULL))
);

CREATE TABLE "content_db"."media_asset" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "ai_image_draft_id" bigint UNIQUE,
  "storage_provider" text NOT NULL DEFAULT 'Cloudinary',
  "provider_public_id" text NOT NULL,
  "delivery_url" text NOT NULL,
  "original_file_name" text,
  "mime_type" text NOT NULL,
  "byte_size" bigint NOT NULL,
  "width" integer NOT NULL,
  "height" integer NOT NULL,
  "source_type" text NOT NULL,
  "state" text NOT NULL DEFAULT 'active',
  "created_by_user_ref" uuid NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "media_asset_byte_size_check" CHECK (byte_size > 0),
  CONSTRAINT "media_asset_dimensions_check" CHECK (width > 0 AND height > 0),
  CONSTRAINT "media_asset_source_type_check" CHECK (source_type IN ('real', 'ai_illustration')),
  CONSTRAINT "media_asset_state_check" CHECK (state = 'active'),
  CONSTRAINT "media_asset_ai_origin_check" CHECK ((source_type = 'real' AND ai_image_draft_id IS NULL) OR (source_type = 'ai_illustration' AND ai_image_draft_id IS NOT NULL))
);

CREATE TABLE "content_db"."outbox_message" (
  "id" uuid PRIMARY KEY,
  "event_type" text NOT NULL,
  "payload" jsonb NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "processed_at" timestamptz,
  "retry_count" integer NOT NULL DEFAULT 0,
  "error" text
);

CREATE INDEX "ai_image_draft_recipe_target_idx" ON "content_db"."ai_image_draft" ("recipe_version_ref", "target_kind");

CREATE INDEX "ai_image_draft_step_idx" ON "content_db"."ai_image_draft" ("recipe_step_ref");

CREATE INDEX "ai_image_draft_cleanup_idx" ON "content_db"."ai_image_draft" ("state", "expires_at");

CREATE INDEX "ai_image_draft_creator_idx" ON "content_db"."ai_image_draft" ("created_by_user_ref", "created_at");

CREATE INDEX "ai_image_draft_worker_lease_idx" ON "content_db"."ai_image_draft" ("state", "lease_expires_at");

CREATE UNIQUE INDEX "media_asset_provider_public_id_uidx" ON "content_db"."media_asset" ("storage_provider", "provider_public_id");

CREATE INDEX "media_asset_library_idx" ON "content_db"."media_asset" ("source_type", "state", "created_at");

CREATE INDEX "media_asset_creator_idx" ON "content_db"."media_asset" ("created_by_user_ref");

CREATE INDEX "outbox_pending_idx" ON "content_db"."outbox_message" ("processed_at", "created_at");

COMMENT ON TABLE "content_db"."ai_image_draft" IS 'Bản ghi giữ lịch sử tác vụ và quyết định sau Accept/Discard; chỉ file tạm được dọn. Trạng thái accepting giữ lease ngăn race giữa Cloudinary upload và cleanup/discard. input_snapshot lưu ngay khi enqueue; prompt_snapshot lưu sau LLM.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."recipe_version_ref" IS 'RecipeVersion public_id từ Recipe Service; không tạo FK xuyên database.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."recipe_step_ref" IS 'RecipeStep public_id; bắt buộc cho step_instruction, phải rỗng cho final_product.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."target_kind" IS 'final_product hoặc step_instruction.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."input_snapshot" IS 'Snapshot JSON context công thức/bước tại thời điểm enqueue.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."prompt_snapshot" IS 'Prompt tiếng Anh gửi image provider; NULL khi queued/processing trước LLM, bắt buộc khi generated/accepted.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."provider" IS 'Nhà cung cấp gen ảnh: CloudflareSchnell.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."geometry_mode" IS 'FLUX Schnell native resolution; không nhận aspect_ratio tùy ý từ client.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."width" IS 'Kích thước pixel thực tế của ảnh.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."height" IS 'Kích thước pixel thực tế của ảnh.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."state" IS 'queued | processing | generated | failed | accepting | accepted | discarded | expired.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."temporary_image_path" IS 'Đường dẫn tương đối trong kho file tạm dùng chung API/worker; NULL khi chưa có ảnh hoặc đã dọn xong.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."mime_type" IS 'MIME type: image/png, image/jpeg, image/webp.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."byte_size" IS 'Dung lượng bytes của file tạm.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."error_code" IS 'Mã lỗi máy đọc được.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."error_message" IS 'Thông báo lỗi đã lọc bí mật.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."lease_token" IS 'Token phân quyền worker lease hoặc accept lease chống ghi đè kết quả.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."lease_expires_at" IS 'Hạn lease ngăn chặn worker cũ ghi đè.';

COMMENT ON COLUMN "content_db"."ai_image_draft"."expires_at" IS 'Hạn duyệt 30 phút tính từ generated_at.';

COMMENT ON TABLE "content_db"."media_asset" IS 'Ảnh chính thức sau Accept hoặc upload thủ công. Metadata và file Cloudinary được lưu bền vững. Vị trí sử dụng do Recipe DB quản lý.';

COMMENT ON COLUMN "content_db"."media_asset"."public_id" IS 'ID công khai dùng cho media_asset_ref phía Recipe Service.';

COMMENT ON COLUMN "content_db"."media_asset"."ai_image_draft_id" IS 'NULL cho ảnh upload thủ công; một draft tối đa tạo một asset.';

COMMENT ON COLUMN "content_db"."media_asset"."provider_public_id" IS 'Cloudinary public ID, dùng quản lý/xóa ảnh; không phải đường dẫn local.';

COMMENT ON COLUMN "content_db"."media_asset"."delivery_url" IS 'URL HTTPS hiển thị ảnh.';

COMMENT ON COLUMN "content_db"."media_asset"."source_type" IS 'real hoặc ai_illustration.';

COMMENT ON COLUMN "content_db"."media_asset"."state" IS 'active. Các trạng thái delete bị loại bỏ vì tính năng DELETE bị hoãn theo R5 gate.';

COMMENT ON TABLE "content_db"."outbox_message" IS 'Transactional Outbox bảo vệ tính nhất quán dữ liệu giữa PostgreSQL và Redis Streams; commit cùng transaction với draft/asset.';

COMMENT ON COLUMN "content_db"."outbox_message"."event_type" IS 'Tên sự kiện: Content.ImageDraftQueued, Content.MediaAssetAccepted, v.v.';

COMMENT ON COLUMN "content_db"."outbox_message"."payload" IS 'Dữ liệu sự kiện JSON serialize.';

COMMENT ON COLUMN "content_db"."outbox_message"."processed_at" IS 'NULL khi chưa publish sang Redis Streams; lưu timestamp khi đã XADD thành công.';

COMMENT ON COLUMN "content_db"."outbox_message"."error" IS 'Lỗi gần nhất nếu relay gặp sự cố.';

ALTER TABLE "content_db"."media_asset" ADD CONSTRAINT "media_asset_ai_draft" FOREIGN KEY ("ai_image_draft_id") REFERENCES "content_db"."ai_image_draft" ("id") ON DELETE RESTRICT DEFERRABLE INITIALLY IMMEDIATE;
