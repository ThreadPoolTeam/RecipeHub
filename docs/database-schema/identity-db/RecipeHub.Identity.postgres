CREATE TABLE IF NOT EXISTS "__EFMigrationsHistory" (
    "MigrationId" character varying(150) NOT NULL,
    "ProductVersion" character varying(32) NOT NULL,
    CONSTRAINT "PK___EFMigrationsHistory" PRIMARY KEY ("MigrationId")
);

START TRANSACTION;


DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
        IF NOT EXISTS(SELECT 1 FROM pg_namespace WHERE nspname = 'identity_db') THEN
            CREATE SCHEMA identity_db;
        END IF;
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE TABLE identity_db.role (
        id bigint GENERATED BY DEFAULT AS IDENTITY,
        name text NOT NULL,
        normalized_name text NOT NULL,
        description text,
        created_at timestamp with time zone NOT NULL DEFAULT (now()),
        CONSTRAINT "PK_role" PRIMARY KEY (id)
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE TABLE identity_db.user_account (
        id bigint GENERATED BY DEFAULT AS IDENTITY,
        public_id uuid NOT NULL,
        user_name text NOT NULL,
        normalized_user_name text NOT NULL,
        email text,
        normalized_email text,
        display_name text NOT NULL,
        state text NOT NULL DEFAULT 'active',
        last_login_at timestamp with time zone,
        created_at timestamp with time zone NOT NULL DEFAULT (now()),
        updated_at timestamp with time zone NOT NULL DEFAULT (now()),
        CONSTRAINT "PK_user_account" PRIMARY KEY (id)
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE TABLE identity_db.auth_credential (
        id bigint GENERATED BY DEFAULT AS IDENTITY,
        user_account_id bigint NOT NULL,
        password_hash text,
        created_at timestamp with time zone NOT NULL DEFAULT (now()),
        updated_at timestamp with time zone NOT NULL DEFAULT (now()),
        CONSTRAINT "PK_auth_credential" PRIMARY KEY (id),
        CONSTRAINT "FK_auth_credential_user_account_user_account_id" FOREIGN KEY (user_account_id) REFERENCES identity_db.user_account (id) ON DELETE CASCADE
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE TABLE identity_db.user_role (
        user_account_id bigint NOT NULL,
        role_id bigint NOT NULL,
        assigned_at timestamp with time zone NOT NULL DEFAULT (now()),
        assigned_by_user_ref uuid,
        CONSTRAINT "PK_user_role" PRIMARY KEY (user_account_id, role_id),
        CONSTRAINT "FK_user_role_role_role_id" FOREIGN KEY (role_id) REFERENCES identity_db.role (id) ON DELETE CASCADE,
        CONSTRAINT "FK_user_role_user_account_user_account_id" FOREIGN KEY (user_account_id) REFERENCES identity_db.user_account (id) ON DELETE CASCADE
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE TABLE identity_db.user_session (
        id bigint GENERATED BY DEFAULT AS IDENTITY,
        session_token_hash text NOT NULL,
        user_account_id bigint NOT NULL,
        created_at timestamp with time zone NOT NULL DEFAULT (now()),
        last_activity_at timestamp with time zone NOT NULL,
        expires_at timestamp with time zone NOT NULL,
        revoked_at timestamp with time zone,
        ip_address inet,
        user_agent text,
        CONSTRAINT "PK_user_session" PRIMARY KEY (id),
        CONSTRAINT "FK_user_session_user_account_user_account_id" FOREIGN KEY (user_account_id) REFERENCES identity_db.user_account (id) ON DELETE CASCADE
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE UNIQUE INDEX auth_credential_user_uidx ON identity_db.auth_credential (user_account_id);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE UNIQUE INDEX "IX_role_normalized_name" ON identity_db.role (normalized_name);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE UNIQUE INDEX "IX_user_account_normalized_email" ON identity_db.user_account (normalized_email);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE UNIQUE INDEX "IX_user_account_normalized_user_name" ON identity_db.user_account (normalized_user_name);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE UNIQUE INDEX "IX_user_account_public_id" ON identity_db.user_account (public_id);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE INDEX user_account_state_idx ON identity_db.user_account (state);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE INDEX user_role_role_idx ON identity_db.user_role (role_id);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE UNIQUE INDEX "IX_user_session_session_token_hash" ON identity_db.user_session (session_token_hash);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE INDEX user_session_expiry_idx ON identity_db.user_session (expires_at);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    CREATE INDEX user_session_user_expiry_idx ON identity_db.user_session (user_account_id, expires_at);
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20261020140022_InitialIdentity') THEN
    INSERT INTO "__EFMigrationsHistory" ("MigrationId", "ProductVersion")
    VALUES ('20261020140022_InitialIdentity', '8.0.11');
    END IF;
END $EF$;
COMMIT;

