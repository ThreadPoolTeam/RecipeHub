Project RecipeHubRecipeDatabase {
  database_type: 'PostgreSQL'
  Note: 'Recipe Service database: Unit, Ingredient and Recipe Core.'
}

// Categories determine which units can be converted or added together.
Table recipe_db.unit_category {
  id bigint [pk, increment]
  public_id uuid [not null, unique]
  code text [not null]
  normalized_code text [not null, unique]
  name text [not null]
  normalized_name text [not null, unique]
  description text
  state text [not null, default: 'active', note: 'active hoặc inactive.']
  created_by_user_ref uuid [not null]
  updated_by_user_ref uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    state [name: 'unit_category_state_idx']
  }

  checks {
    `state IN ('active', 'inactive')` [name: 'unit_category_state_check']
  }

  Note: 'Nhóm phân loại đơn vị; API quy đổi metric chỉ chấp nhận cùng nhóm và cùng đại lượng vật lý. Phép tính không ghi DB.'
}

// Display units grouped by category.
Table recipe_db.unit {
  id bigint [pk, increment]
  public_id uuid [not null, unique]
  code text [not null]
  normalized_code text [not null, unique]
  name text [not null]
  category_id bigint [not null]
  decimal_places smallint [not null, default: 2, note: 'Số chữ số thập phân khi làm tròn.']
  state text [not null, default: 'active']
  created_by_user_ref uuid [not null]
  updated_by_user_ref uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (category_id, state) [name: 'unit_category_usage_state_idx']
  }

  checks {
    `decimal_places BETWEEN 0 AND 6` [name: 'unit_decimal_places_check']
    `state IN ('active', 'inactive')` [name: 'unit_state_check']
  }

  Note: 'Đơn vị thuộc một nhóm. Quy đổi metric mg/g/kg và ml/cl/dl/l dùng hệ số vật lý cố định; đơn vị khác chỉ đổi sang chính nó. Không suy đoán cup/shot hoặc khối lượng sang thể tích.'
}

// Ingredient categories used to group and filter the shared catalog.
Table recipe_db.ingredient_category {
  id bigint [pk, increment]
  public_id uuid [not null, unique]
  code text [not null]
  normalized_code text [not null, unique]
  name text [not null]
  normalized_name text [not null, unique]
  description text
  state text [not null, default: 'active', note: 'active hoặc inactive.']
  created_by_user_ref uuid [not null]
  updated_by_user_ref uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    state [name: 'ingredient_category_state_idx']
  }

  checks {
    `state IN ('active', 'inactive')` [name: 'ingredient_category_state_check']
  }

  Note: 'Danh mục nguyên liệu, ví dụ Tea, Dairy hoặc Sweetener. Không hard-delete danh mục đã được sử dụng.'
}

// Shared ingredient catalog with soft-delete state.
Table recipe_db.ingredient {
  id bigint [pk, increment]
  public_id uuid [not null, unique]
  code text [not null]
  normalized_code text [not null, unique]
  name text [not null]
  normalized_name text [not null]
  category_id bigint [not null]
  default_unit_id bigint [not null]
  description text
  warning text
  note text
  image_asset_ref uuid [note: 'MediaAsset public ID từ Content Service; không tạo FK xuyên database.']
  state text [not null, default: 'active', note: 'active hoặc inactive; không hard-delete khi đã được công thức dùng.']
  created_by_user_ref uuid [not null]
  updated_by_user_ref uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    normalized_name [name: 'ingredient_name_idx']
    (category_id, state) [name: 'ingredient_category_usage_state_idx']
    default_unit_id [name: 'ingredient_default_unit_idx']
    image_asset_ref [name: 'ingredient_image_reference_idx']
  }

  checks {
    `state IN ('active', 'inactive')` [name: 'ingredient_state_check']
  }

  Note: 'Không có bảng Supplier, tồn kho hoặc lô hàng. category_id dùng để phân loại và lọc nguyên liệu.'
}

// Stable recipe identity and archive state.
Table recipe_db.recipe {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'ID công khai dùng giữa các service.']
  code text [not null, note: 'Mã công thức do người dùng nhập.']
  normalized_code text [not null, unique, note: 'Mã chuẩn hóa để chống trùng không phân biệt hoa thường.']
  created_by_user_ref uuid [not null, note: 'User public_id từ Identity Service.']
  updated_by_user_ref uuid [not null, note: 'User public_id từ Identity Service.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    created_by_user_ref [name: 'recipe_created_by_idx']
    archived_at [name: 'recipe_archived_at_idx']
  }

  Note: 'Không hard-delete Recipe. archived_at đánh dấu công thức đã lưu trữ.'
}

// All editable recipe content belongs to a version.
Table recipe_db.recipe_version {
  id bigint [pk, increment]
  public_id uuid [not null, unique]
  recipe_id bigint [not null]
  version_number integer [not null, note: 'Số phiên bản tăng dần trong từng Recipe.']
  status text [not null, default: 'draft', note: 'draft hoặc published.']
  name text [not null]
  normalized_name text [not null, note: 'Tên chuẩn hóa để tìm kiếm không phân biệt hoa thường.']
  description text
  primary_media_asset_ref uuid [note: 'MediaAsset public ID từ Content Service làm ảnh đại diện thành phẩm.']
  created_by_user_ref uuid [not null]
  updated_by_user_ref uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  published_by_user_ref uuid
  indexes {
    (recipe_id, version_number) [unique, name: 'recipe_version_number_uidx']
    normalized_name [name: 'recipe_version_name_idx']
    status [name: 'recipe_version_status_idx']
    created_by_user_ref [name: 'recipe_version_created_by_idx']
    updated_at [name: 'recipe_version_updated_at_idx']
    primary_media_asset_ref [name: 'recipe_version_primary_media_idx']
  }

  checks {
    `version_number > 0` [name: 'recipe_version_number_check']
    `status IN ('draft', 'published')` [name: 'recipe_version_status_check']
    `(status = 'draft' AND published_at IS NULL AND published_by_user_ref IS NULL) OR (status = 'published' AND published_at IS NOT NULL AND published_by_user_ref IS NOT NULL)` [name: 'recipe_version_publication_check']
  }

  Note: 'Một Recipe chỉ có tối đa một draft; published versions là bất biến.'
}

// Standard output produced by one recipe version.
Table recipe_db.recipe_yield {
  id bigint [pk, increment]
  recipe_version_id bigint [not null, unique, note: 'Một phiên bản công thức có tối đa một bản ghi sản lượng.']
  quantity numeric(18,6) [not null, note: 'Số lượng thành phẩm tạo ra, ví dụ 1.5 hoặc 10.']
  unit_id bigint [not null, note: 'Đơn vị của thành phẩm, ví dụ L, ml, cup hoặc serving.']
  note text [note: 'Mô tả thêm khi cần, ví dụ 10 chai, mỗi chai 250 ml.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    unit_id [name: 'recipe_yield_unit_idx']
  }

  checks {
    `quantity > 0` [name: 'recipe_yield_quantity_check']
  }

  Note: 'Sản lượng của một phiên bản công thức; bắt buộc khi publish.'
}

// Ingredient lines and immutable snapshots for historical versions.
Table recipe_db.recipe_ingredient {
  id bigint [pk, increment]
  recipe_version_id bigint [not null]
  ingredient_id bigint [not null]
  unit_id bigint [not null, note: 'Đơn vị dùng cho định lượng.']
  quantity numeric(18,6) [not null]
  sort_order integer [not null]
  stage_name text [note: 'Giai đoạn sử dụng nếu nguyên liệu xuất hiện nhiều lần.']
  note text
  ingredient_code_snapshot text [not null]
  ingredient_name_snapshot text [not null]
  ingredient_warning_snapshot text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (recipe_version_id, sort_order) [name: 'recipe_ingredient_order_idx']
    ingredient_id [name: 'recipe_ingredient_ingredient_idx']
    unit_id [name: 'recipe_ingredient_unit_idx']
  }

  checks {
    `quantity > 0` [name: 'recipe_ingredient_quantity_check']
    `sort_order > 0` [name: 'recipe_ingredient_sort_order_check']
  }

  Note: 'Một nguyên liệu có thể xuất hiện ở nhiều công đoạn khác nhau.'
}

// Ordered preparation steps.
Table recipe_db.recipe_step {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'ID công khai ổn định của bước công thức.']
  recipe_version_id bigint [not null]
  sort_order integer [not null]
  title text [not null]
  description text [not null]
  duration_seconds integer
  temperature_celsius numeric(8,2)
  equipment text
  safety_note text
  completion_criteria text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (recipe_version_id, sort_order) [name: 'recipe_step_order_idx']
  }

  checks {
    `sort_order > 0` [name: 'recipe_step_sort_order_check']
    `duration_seconds IS NULL OR duration_seconds >= 0` [name: 'recipe_step_duration_check']
  }
}

// Media references owned by Content Service.
Table recipe_db.recipe_step_media {
  id bigint [pk, increment]
  public_id uuid [not null, unique, note: 'ID công khai ổn định của liên kết media (linkId).']
  recipe_step_id bigint [not null]
  media_asset_ref uuid [not null, note: 'MediaAsset public ID từ Content Service; không tạo FK xuyên database.']
  sort_order integer [not null, default: 1]
  is_primary boolean [not null, default: false]
  caption text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (recipe_step_id, media_asset_ref) [unique, name: 'recipe_step_media_asset_uidx']
    (recipe_step_id, sort_order) [name: 'recipe_step_media_order_idx']
    media_asset_ref [name: 'recipe_step_media_reference_idx']
  }

  checks {
    `sort_order > 0` [name: 'recipe_step_media_sort_order_check']
  }

  Note: 'PostgreSQL migration cần partial unique index trên recipe_step_id WHERE is_primary = true. Content Service kiểm tra tham chiếu qua media_asset_ref trước khi xóa file.'
}

Ref unit_category: recipe_db.unit.category_id > recipe_db.unit_category.id [delete: restrict]
Ref ingredient_category: recipe_db.ingredient.category_id > recipe_db.ingredient_category.id [delete: restrict]
Ref ingredient_default_unit: recipe_db.ingredient.default_unit_id > recipe_db.unit.id [delete: restrict]
Ref recipe_version_recipe: recipe_db.recipe_version.recipe_id > recipe_db.recipe.id [delete: restrict]
Ref recipe_yield_version: recipe_db.recipe_yield.recipe_version_id > recipe_db.recipe_version.id [delete: cascade]
Ref recipe_yield_unit: recipe_db.recipe_yield.unit_id > recipe_db.unit.id [delete: restrict]
Ref recipe_ingredient_version: recipe_db.recipe_ingredient.recipe_version_id > recipe_db.recipe_version.id [delete: cascade]
Ref recipe_ingredient_master: recipe_db.recipe_ingredient.ingredient_id > recipe_db.ingredient.id [delete: restrict]
Ref recipe_ingredient_unit: recipe_db.recipe_ingredient.unit_id > recipe_db.unit.id [delete: restrict]
Ref recipe_step_version: recipe_db.recipe_step.recipe_version_id > recipe_db.recipe_version.id [delete: cascade]
Ref recipe_step_media_step: recipe_db.recipe_step_media.recipe_step_id > recipe_db.recipe_step.id [delete: cascade]
