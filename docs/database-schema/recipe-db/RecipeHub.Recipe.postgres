CREATE SCHEMA "recipe_db";

CREATE TABLE "recipe_db"."unit_category" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "code" text NOT NULL,
  "normalized_code" text UNIQUE NOT NULL,
  "name" text NOT NULL,
  "normalized_name" text UNIQUE NOT NULL,
  "description" text,
  "state" text NOT NULL DEFAULT 'active',
  "created_by_user_ref" uuid NOT NULL,
  "updated_by_user_ref" uuid NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "unit_category_state_check" CHECK (state IN ('active', 'inactive'))
);

CREATE TABLE "recipe_db"."unit" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "code" text NOT NULL,
  "normalized_code" text UNIQUE NOT NULL,
  "name" text NOT NULL,
  "category_id" bigint NOT NULL,
  "decimal_places" smallint NOT NULL DEFAULT 2,
  "state" text NOT NULL DEFAULT 'active',
  "created_by_user_ref" uuid NOT NULL,
  "updated_by_user_ref" uuid NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "unit_decimal_places_check" CHECK (decimal_places BETWEEN 0 AND 6),
  CONSTRAINT "unit_state_check" CHECK (state IN ('active', 'inactive'))
);

CREATE TABLE "recipe_db"."ingredient_category" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "code" text NOT NULL,
  "normalized_code" text UNIQUE NOT NULL,
  "name" text NOT NULL,
  "normalized_name" text UNIQUE NOT NULL,
  "description" text,
  "state" text NOT NULL DEFAULT 'active',
  "created_by_user_ref" uuid NOT NULL,
  "updated_by_user_ref" uuid NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "ingredient_category_state_check" CHECK (state IN ('active', 'inactive'))
);

CREATE TABLE "recipe_db"."ingredient" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "code" text NOT NULL,
  "normalized_code" text UNIQUE NOT NULL,
  "name" text NOT NULL,
  "normalized_name" text NOT NULL,
  "category_id" bigint NOT NULL,
  "default_unit_id" bigint NOT NULL,
  "description" text,
  "warning" text,
  "note" text,
  "image_asset_ref" uuid,
  "state" text NOT NULL DEFAULT 'active',
  "created_by_user_ref" uuid NOT NULL,
  "updated_by_user_ref" uuid NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "ingredient_state_check" CHECK (state IN ('active', 'inactive'))
);

CREATE TABLE "recipe_db"."recipe" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "code" text NOT NULL,
  "normalized_code" text UNIQUE NOT NULL,
  "created_by_user_ref" uuid NOT NULL,
  "updated_by_user_ref" uuid NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  "archived_at" timestamptz
);

CREATE TABLE "recipe_db"."recipe_version" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "recipe_id" bigint NOT NULL,
  "version_number" integer NOT NULL,
  "status" text NOT NULL DEFAULT 'draft',
  "name" text NOT NULL,
  "normalized_name" text NOT NULL,
  "description" text,
  "primary_media_asset_ref" uuid,
  "created_by_user_ref" uuid NOT NULL,
  "updated_by_user_ref" uuid NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  "published_at" timestamptz,
  "published_by_user_ref" uuid,
  CONSTRAINT "recipe_version_number_check" CHECK (version_number > 0),
  CONSTRAINT "recipe_version_status_check" CHECK (status IN ('draft', 'published')),
  CONSTRAINT "recipe_version_publication_check" CHECK ((status = 'draft' AND published_at IS NULL AND published_by_user_ref IS NULL) OR (status = 'published' AND published_at IS NOT NULL AND published_by_user_ref IS NOT NULL))
);

CREATE TABLE "recipe_db"."recipe_yield" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "recipe_version_id" bigint UNIQUE NOT NULL,
  "quantity" numeric(18,6) NOT NULL,
  "unit_id" bigint NOT NULL,
  "note" text,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "recipe_yield_quantity_check" CHECK (quantity > 0)
);

CREATE TABLE "recipe_db"."recipe_ingredient" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "recipe_version_id" bigint NOT NULL,
  "ingredient_id" bigint NOT NULL,
  "unit_id" bigint NOT NULL,
  "quantity" numeric(18,6) NOT NULL,
  "sort_order" integer NOT NULL,
  "stage_name" text,
  "note" text,
  "ingredient_code_snapshot" text NOT NULL,
  "ingredient_name_snapshot" text NOT NULL,
  "ingredient_warning_snapshot" text,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "recipe_ingredient_quantity_check" CHECK (quantity > 0),
  CONSTRAINT "recipe_ingredient_sort_order_check" CHECK (sort_order > 0)
);

CREATE TABLE "recipe_db"."recipe_step" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "recipe_version_id" bigint NOT NULL,
  "sort_order" integer NOT NULL,
  "title" text NOT NULL,
  "description" text NOT NULL,
  "duration_seconds" integer,
  "temperature_celsius" numeric(8,2),
  "equipment" text,
  "safety_note" text,
  "completion_criteria" text,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  "updated_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "recipe_step_sort_order_check" CHECK (sort_order > 0),
  CONSTRAINT "recipe_step_duration_check" CHECK (duration_seconds IS NULL OR duration_seconds >= 0)
);

CREATE TABLE "recipe_db"."recipe_step_media" (
  "id" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "public_id" uuid UNIQUE NOT NULL,
  "recipe_step_id" bigint NOT NULL,
  "media_asset_ref" uuid NOT NULL,
  "sort_order" integer NOT NULL DEFAULT 1,
  "is_primary" boolean NOT NULL DEFAULT false,
  "caption" text,
  "created_at" timestamptz NOT NULL DEFAULT (now()),
  CONSTRAINT "recipe_step_media_sort_order_check" CHECK (sort_order > 0)
);

CREATE INDEX "unit_category_state_idx" ON "recipe_db"."unit_category" ("state");

CREATE INDEX "unit_category_usage_state_idx" ON "recipe_db"."unit" ("category_id", "state");

CREATE INDEX "ingredient_category_state_idx" ON "recipe_db"."ingredient_category" ("state");

CREATE INDEX "ingredient_name_idx" ON "recipe_db"."ingredient" ("normalized_name");

CREATE INDEX "ingredient_category_usage_state_idx" ON "recipe_db"."ingredient" ("category_id", "state");

CREATE INDEX "ingredient_default_unit_idx" ON "recipe_db"."ingredient" ("default_unit_id");

CREATE INDEX "ingredient_image_reference_idx" ON "recipe_db"."ingredient" ("image_asset_ref");

CREATE INDEX "recipe_archived_at_idx" ON "recipe_db"."recipe" ("archived_at");

CREATE INDEX "recipe_created_by_idx" ON "recipe_db"."recipe" ("created_by_user_ref");


CREATE UNIQUE INDEX "recipe_version_number_uidx" ON "recipe_db"."recipe_version" ("recipe_id", "version_number");

CREATE INDEX "recipe_version_name_idx" ON "recipe_db"."recipe_version" ("normalized_name");

CREATE INDEX "recipe_version_status_idx" ON "recipe_db"."recipe_version" ("status");

CREATE INDEX "recipe_version_created_by_idx" ON "recipe_db"."recipe_version" ("created_by_user_ref");

CREATE INDEX "recipe_version_updated_at_idx" ON "recipe_db"."recipe_version" ("updated_at");


CREATE INDEX "recipe_version_primary_media_idx" ON "recipe_db"."recipe_version" ("primary_media_asset_ref");

CREATE INDEX "recipe_yield_unit_idx" ON "recipe_db"."recipe_yield" ("unit_id");

CREATE INDEX "recipe_ingredient_order_idx" ON "recipe_db"."recipe_ingredient" ("recipe_version_id", "sort_order");

CREATE INDEX "recipe_ingredient_ingredient_idx" ON "recipe_db"."recipe_ingredient" ("ingredient_id");

CREATE INDEX "recipe_ingredient_unit_idx" ON "recipe_db"."recipe_ingredient" ("unit_id");

CREATE INDEX "recipe_step_order_idx" ON "recipe_db"."recipe_step" ("recipe_version_id", "sort_order");

CREATE UNIQUE INDEX "recipe_step_media_asset_uidx" ON "recipe_db"."recipe_step_media" ("recipe_step_id", "media_asset_ref");

CREATE INDEX "recipe_step_media_order_idx" ON "recipe_db"."recipe_step_media" ("recipe_step_id", "sort_order");

CREATE INDEX "recipe_step_media_reference_idx" ON "recipe_db"."recipe_step_media" ("media_asset_ref");

COMMENT ON TABLE "recipe_db"."unit_category" IS 'Nhóm phân loại đơn vị hiển thị; MVP không tự động quy đổi đơn vị.';

COMMENT ON COLUMN "recipe_db"."unit_category"."state" IS 'active hoặc inactive.';

COMMENT ON TABLE "recipe_db"."unit" IS 'Đơn vị hiển thị thuộc một nhóm; MVP không tự động quy đổi đơn vị.';

COMMENT ON COLUMN "recipe_db"."unit"."decimal_places" IS 'Số chữ số thập phân khi làm tròn.';

COMMENT ON TABLE "recipe_db"."ingredient_category" IS 'Danh mục nguyên liệu, ví dụ Tea, Dairy hoặc Sweetener. Không hard-delete danh mục đã được sử dụng.';

COMMENT ON COLUMN "recipe_db"."ingredient_category"."state" IS 'active hoặc inactive.';

COMMENT ON TABLE "recipe_db"."ingredient" IS 'Không có bảng Supplier, tồn kho hoặc lô hàng. category_id dùng để phân loại và lọc nguyên liệu.';

COMMENT ON COLUMN "recipe_db"."ingredient"."image_asset_ref" IS 'MediaAsset public ID từ Content Service; không tạo FK xuyên database.';

COMMENT ON COLUMN "recipe_db"."ingredient"."state" IS 'active hoặc inactive; không hard-delete khi đã được công thức dùng.';

COMMENT ON TABLE "recipe_db"."recipe" IS 'Không hard-delete Recipe. archived_at đánh dấu công thức đã lưu trữ.';

COMMENT ON COLUMN "recipe_db"."recipe"."public_id" IS 'ID công khai dùng giữa các service.';

COMMENT ON COLUMN "recipe_db"."recipe"."code" IS 'Mã công thức do người dùng nhập.';

COMMENT ON COLUMN "recipe_db"."recipe"."normalized_code" IS 'Mã chuẩn hóa để chống trùng không phân biệt hoa thường.';

COMMENT ON COLUMN "recipe_db"."recipe"."created_by_user_ref" IS 'User public_id từ Identity Service.';

COMMENT ON COLUMN "recipe_db"."recipe"."updated_by_user_ref" IS 'User public_id từ Identity Service.';

COMMENT ON TABLE "recipe_db"."recipe_version" IS 'Một Recipe chỉ có tối đa một draft; published versions là bất biến.';

COMMENT ON COLUMN "recipe_db"."recipe_version"."version_number" IS 'Số phiên bản tăng dần trong từng Recipe.';

COMMENT ON COLUMN "recipe_db"."recipe_version"."status" IS 'draft hoặc published.';

COMMENT ON COLUMN "recipe_db"."recipe_version"."normalized_name" IS 'Tên chuẩn hóa để tìm kiếm không phân biệt hoa thường.';


COMMENT ON COLUMN "recipe_db"."recipe_version"."primary_media_asset_ref" IS 'MediaAsset public ID từ Content Service làm ảnh đại diện thành phẩm.';

COMMENT ON TABLE "recipe_db"."recipe_yield" IS 'Sản lượng của một phiên bản công thức; bắt buộc khi publish.';

COMMENT ON COLUMN "recipe_db"."recipe_yield"."recipe_version_id" IS 'Một phiên bản công thức có tối đa một bản ghi sản lượng.';

COMMENT ON COLUMN "recipe_db"."recipe_yield"."quantity" IS 'Số lượng thành phẩm tạo ra, ví dụ 1.5 hoặc 10.';

COMMENT ON COLUMN "recipe_db"."recipe_yield"."unit_id" IS 'Đơn vị của thành phẩm, ví dụ L, ml, cup hoặc serving.';

COMMENT ON COLUMN "recipe_db"."recipe_yield"."note" IS 'Mô tả thêm khi cần, ví dụ 10 chai, mỗi chai 250 ml.';

COMMENT ON TABLE "recipe_db"."recipe_ingredient" IS 'Một nguyên liệu có thể xuất hiện ở nhiều công đoạn khác nhau.';

COMMENT ON COLUMN "recipe_db"."recipe_ingredient"."unit_id" IS 'Đơn vị dùng cho định lượng.';

COMMENT ON COLUMN "recipe_db"."recipe_ingredient"."stage_name" IS 'Giai đoạn sử dụng nếu nguyên liệu xuất hiện nhiều lần.';

COMMENT ON COLUMN "recipe_db"."recipe_step"."public_id" IS 'ID công khai ổn định của bước công thức.';

COMMENT ON TABLE "recipe_db"."recipe_step_media" IS 'PostgreSQL migration cần partial unique index trên recipe_step_id WHERE is_primary = true. Content Service kiểm tra tham chiếu qua media_asset_ref trước khi xóa file.';

COMMENT ON COLUMN "recipe_db"."recipe_step_media"."public_id" IS 'ID công khai ổn định của liên kết media (linkId).';

COMMENT ON COLUMN "recipe_db"."recipe_step_media"."media_asset_ref" IS 'MediaAsset public ID từ Content Service; không tạo FK xuyên database.';

ALTER TABLE "recipe_db"."unit" ADD CONSTRAINT "unit_category" FOREIGN KEY ("category_id") REFERENCES "recipe_db"."unit_category" ("id") ON DELETE RESTRICT DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."ingredient" ADD CONSTRAINT "ingredient_category" FOREIGN KEY ("category_id") REFERENCES "recipe_db"."ingredient_category" ("id") ON DELETE RESTRICT DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."ingredient" ADD CONSTRAINT "ingredient_default_unit" FOREIGN KEY ("default_unit_id") REFERENCES "recipe_db"."unit" ("id") ON DELETE RESTRICT DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."recipe_version" ADD CONSTRAINT "recipe_version_recipe" FOREIGN KEY ("recipe_id") REFERENCES "recipe_db"."recipe" ("id") ON DELETE RESTRICT DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."recipe_yield" ADD CONSTRAINT "recipe_yield_version" FOREIGN KEY ("recipe_version_id") REFERENCES "recipe_db"."recipe_version" ("id") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."recipe_yield" ADD CONSTRAINT "recipe_yield_unit" FOREIGN KEY ("unit_id") REFERENCES "recipe_db"."unit" ("id") ON DELETE RESTRICT DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."recipe_ingredient" ADD CONSTRAINT "recipe_ingredient_version" FOREIGN KEY ("recipe_version_id") REFERENCES "recipe_db"."recipe_version" ("id") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."recipe_ingredient" ADD CONSTRAINT "recipe_ingredient_master" FOREIGN KEY ("ingredient_id") REFERENCES "recipe_db"."ingredient" ("id") ON DELETE RESTRICT DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."recipe_ingredient" ADD CONSTRAINT "recipe_ingredient_unit" FOREIGN KEY ("unit_id") REFERENCES "recipe_db"."unit" ("id") ON DELETE RESTRICT DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."recipe_step" ADD CONSTRAINT "recipe_step_version" FOREIGN KEY ("recipe_version_id") REFERENCES "recipe_db"."recipe_version" ("id") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "recipe_db"."recipe_step_media" ADD CONSTRAINT "recipe_step_media_step" FOREIGN KEY ("recipe_step_id") REFERENCES "recipe_db"."recipe_step" ("id") ON DELETE CASCADE DEFERRABLE INITIALLY IMMEDIATE;

-- Partial unique indexes required by business rules
CREATE UNIQUE INDEX IF NOT EXISTS "recipe_step_one_primary_media_uidx" ON "recipe_db"."recipe_step_media" ("recipe_step_id") WHERE is_primary = true;
CREATE UNIQUE INDEX IF NOT EXISTS "recipe_one_active_version_uidx" ON "recipe_db"."recipe_version" ("recipe_id") WHERE status = 'draft';
