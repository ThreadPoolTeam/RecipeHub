<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <mxCell id="title_banner" value="&lt;b&gt;RECIPEHUB - THIẾT KẾ CƠ SỞ DỮ LIỆU 2/2: TỪ LOGIC ĐẾN VẬT LÝ (LOGICAL TO PHYSICAL MAPPING)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-weight:normal;&quot;&gt;Slide 15 | Chuẩn Presentation Guideline V11 | Chuyển đổi mô hình logic sang database PostgreSQL thực tế có ràng buộc bảo vệ và chỉ mục tối ưu&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=center;shadow=1;spacing=6;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="1520" height="55" as="geometry" />
    </mxCell>

    <mxCell id="outer_container" value="&lt;b&gt;Minh Chứng Hiện Thực Dữ Liệu: Ánh Xạ Thực Thể Cốt Lõi RecipeVersion Sang Bảng PostgreSQL recipe_version&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=4;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#1e293b;fontSize=12;fontStyle=1;shadow=1;collapsible=0;" vertex="1" parent="1">
      <mxGeometry x="40" y="90" width="1520" height="580" as="geometry" />
    </mxCell>

    <mxCell id="box_logical" value="&lt;div style=&quot;background-color:#ecfdf5;padding:8px;border-radius:4px;border:1px solid #10b981;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#065f46;&quot;&gt;RECIPE_VERSION (Logical Entity)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#047857;&quot;&gt;Đặc tả nghiệp vụ chuẩn hóa (Chưa phụ thuộc DBMS)&lt;/span&gt;&lt;/div&gt;&lt;hr style=&quot;margin:8px 0;border-color:#cbd5e1;&quot;&gt;&lt;table style=&quot;width:100%;font-size:11px;line-height:1.7;color:#1e293b;&quot;&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;RecipeVersionId&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(Logical Identifier)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;RecipeRef&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(Parent Recipe Reference)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;VersionNumber&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(v1, v2, v3... tăng dần)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Status&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(Draft, Published)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Name&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(Tên hiển thị công thức)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;NormalizedName&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(Chuẩn hóa tìm kiếm)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;PrimaryMediaRef&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(Ảnh đại diện thành phẩm)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;PublishedTimestamp&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(Thời điểm ban hành)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;ReviewerRef&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(Quản lý duyệt)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;CreatedAt / UpdatedAt&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#64748b;&quot;&gt;(Thời gian kiểm toán)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;shadow=1;spacing=10;fontSize=11;" vertex="1" parent="outer_container">
      <mxGeometry x="30" y="50" width="340" height="490" as="geometry" />
    </mxCell>

    <mxCell id="arrow_mapping" value="&lt;b style=&quot;font-size:12px;color:#059669;&quot;&gt;Ánh Xạ DB-First&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;100% Cột, Constraints, Index&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=3;endArrow=block;endFill=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="outer_container" source="box_logical" target="box_physical">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="box_physical" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;thead&gt;&lt;tr style=&quot;background-color:#0f172a;color:#ffffff;text-align:left;&quot;&gt;&lt;th style=&quot;padding:8px 10px;border-top-left-radius:4px;&quot;&gt;Cột (PostgreSQL)&lt;/th&gt;&lt;th style=&quot;padding:8px 10px;&quot;&gt;Kiểu Dữ Liệu&lt;/th&gt;&lt;th style=&quot;padding:8px 10px;border-top-right-radius:4px;&quot;&gt;Ràng Buộc (Constraints &amp; Integrity Rules)&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody style=&quot;color:#1e293b;&quot;&gt;&lt;tr style=&quot;background-color:#f8fafc;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;BIGINT&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;span style=&quot;background:#fee2e2;color:#991b1b;padding:2px 6px;border-radius:3px;font-weight:bold;&quot;&gt;PRIMARY KEY&lt;/span&gt; GENERATED ALWAYS AS IDENTITY&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;public_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b&gt;NOT NULL, UNIQUE&lt;/b&gt; (ID định danh API / gRPC)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;recipe_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;BIGINT&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;span style=&quot;background:#dbeafe;color:#1e40af;padding:2px 6px;border-radius:3px;font-weight:bold;&quot;&gt;FOREIGN KEY&lt;/span&gt; REFERENCES recipe(id) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;version_number&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b&gt;NOT NULL&lt;/b&gt;, &lt;code style=&quot;color:#c026d3;&quot;&gt;CHECK (version_number &gt; 0)&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;status&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b&gt;DEFAULT &apos;draft&apos;&lt;/b&gt;, &lt;code style=&quot;color:#c026d3;&quot;&gt;CHECK (status IN (&apos;draft&apos;, &apos;published&apos;))&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;name&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b&gt;NOT NULL&lt;/b&gt;, &lt;code style=&quot;color:#c026d3;&quot;&gt;CHECK (length(btrim(name)) &gt; 0)&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;normalized_name&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b&gt;NOT NULL&lt;/b&gt;, hỗ trợ tìm kiếm không phân biệt hoa thường&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;primary_media_asset_ref&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;NULLABLE (Tham chiếu MediaAsset từ Content Service)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;published_at&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;NULLABLE (Có giá trị khi và chỉ khi status = &apos;published&apos;)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;published_by_user_ref&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;UUID&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;NULLABLE (PublicId quản lý duyệt từ Identity Service)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc;&quot;&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;created_at / updated_at&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;color:#2563eb;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;&quot;&gt;&lt;b&gt;NOT NULL, DEFAULT now()&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;align=left;verticalAlign=top;shadow=1;spacing=4;fontSize=11;" vertex="1" parent="outer_container">
      <mxGeometry x="460" y="50" width="1030" height="490" as="geometry" />
    </mxCell>

    <mxCell id="box_indexes_proof" value="&lt;b&gt;CHỈ MỤC TỐI ƯU (INDEXES) &amp; RÀNG BUỘC PHỨC HỢP BẢO VỆ BUSINESS RULES&lt;/b&gt;&lt;hr style=&quot;margin:6px 0;border-color:#cbd5e1;&quot;&gt;&lt;table style=&quot;width:100%;font-size:11px;color:#1e293b;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:50%;padding:4px 8px;vertical-align:top;&quot;&gt;• &lt;b style=&quot;color:#059669;&quot;&gt;recipe_version_number_uidx:&lt;/b&gt; &lt;code&gt;UNIQUE (recipe_id, version_number)&lt;/code&gt; &amp;rarr; Đảm bảo số phiên bản không trùng lặp trong cùng công thức.&lt;br&gt;• &lt;b style=&quot;color:#059669;&quot;&gt;recipe_one_active_version_uidx:&lt;/b&gt; &lt;code&gt;CREATE UNIQUE INDEX ON recipe_version (recipe_id) WHERE status = &apos;draft&apos;;&lt;/code&gt;&lt;br&gt;&amp;rarr; &lt;b style=&quot;color:#dc2626;&quot;&gt;Bảo vệ [BR-02]&lt;/b&gt; ngay tầng Database Engine: Cấm tạo quá 1 bản ghi Draft cùng lúc.&lt;/td&gt;&lt;td style=&quot;width:50%;padding:4px 8px;vertical-align:top;&quot;&gt;• &lt;b style=&quot;color:#059669;&quot;&gt;recipe_version_publication_check:&lt;/b&gt;&lt;br&gt;&lt;code&gt;CHECK ((status = &apos;draft&apos; AND published_at IS NULL) OR (status = &apos;published&apos; AND published_at IS NOT NULL AND published_by_user_ref IS NOT NULL))&lt;/code&gt;&lt;br&gt;&amp;rarr; Đảm bảo tính toàn vẹn trạng thái xuất bản.&lt;br&gt;• &lt;b style=&quot;color:#059669;&quot;&gt;Minh chứng file DDL thật trong Git:&lt;/b&gt; &lt;a href=&quot;#&quot; style=&quot;color:#2563eb;&quot;&gt;docs/database-schema/recipe-db/RecipeHub.Recipe.postgres&lt;/a&gt; (Dòng 195-227).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;shadow=1;spacing=8;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="40" y="690" width="1520" height="150" as="geometry" />
    </mxCell>

    <mxCell id="compliance_warn15" value="&lt;b style=&quot;color:#b91c1c;&quot;&gt;ĐIỂM CHẾT CẦN TRÁNH (SLIDE 15 COMPLIANCE):&lt;/b&gt; Không chụp màn hình các bảng pgAdmin/DBeaver rời rạc. Phải trình bày bảng đối chiếu trường dữ liệu, kiểu dữ liệu, ràng buộc bảo vệ (CHECK, NOT NULL, UNIQUE, FK) và dẫn chứng file migration / schema export chính thức." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;strokeWidth=1.5;align=center;shadow=0;fontSize=11;fontColor=#991b1b;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="40" y="860" width="1520" height="40" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>