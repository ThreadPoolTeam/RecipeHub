      <mxCell id="c_parts" value="&lt;b&gt;RecipeIngredient &amp; RecipeStep&lt;/b&gt;&lt;br&gt;&lt;small style='font-size:9px;color:#581c87;'&gt;«Domain Child Entities &amp; Value Objects»&lt;/small&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontalStack=0;resizeParent=1;resizeParentMax=0;horizontal=1;startSize=36;collapsible=0;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=1.5;fontColor=#581c87;fontSize=12;shadow=1;" vertex="1" parent="1">
        <mxGeometry x="900" y="380" width="330" height="250" as="geometry" />
      </mxCell>
    

      <mxCell id="c_parts_fields" value="• «RecipeIngredient»&lt;br&gt;• + IngredientId / UnitId: long&lt;br&gt;• + Quantity: decimal (&gt; 0)&lt;br&gt;• + StageName / Note: string?&lt;br&gt;• + IngredientCodeSnapshot: string&lt;br&gt;• «RecipeStep»&lt;br&gt;• + SortOrder / Title / Description&lt;br&gt;• + DurationSeconds / TemperatureCelsius" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingBottom=6;html=1;fontSize=10;fontColor=#1e293b;" vertex="1" parent="c_parts">
        <mxGeometry y="36" width="330" height="140" as="geometry" />
      </mxCell>
    

      <mxCell id="c_parts_sep" value="" style="line;strokeWidth=1;fillColor=none;strokeColor=#9333ea;align=left;verticalAlign=middle;rotatable=0;html=1;" vertex="1" parent="c_parts">
        <mxGeometry y="176" width="330" height="4" as="geometry" />
      </mxCell>
    

      <mxCell id="c_parts_methods" value="+ + ValidateQuantity(): bool&lt;br&gt;+ + AddMedia(mediaAssetRef, isPrimary)" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingBottom=6;html=1;fontSize=10;fontColor=#0f172a;" vertex="1" parent="c_parts">
        <mxGeometry y="180" width="330" height="46" as="geometry" />
      </mxCell>
    

    <mxCell id="box_rules" value="&lt;b style='font-size:12px;color:#0f172a;'&gt;VỊ TRÍ CỦA BUSINESS RULES &amp;amp; PHÂN ĐỊNH TRÁCH NHIỆM (CLEAN ARCHITECTURE):&lt;/b&gt;&lt;br&gt;&lt;div style='font-size:11px;color:#334155;line-height:1.45;padding-top:4px;'&gt;• &lt;b&gt;Presentation Layer (RecipesController):&lt;/b&gt; Tiếp nhận HTTP request, chuyển đổi DTO, xác thực phân quyền vai trò &lt;b&gt;[BR-05]&lt;/b&gt; (chỉ R&amp;D/Admin được xuất bản, Viewer chỉ được đọc bản published). Không chứa nghiệp vụ tính toán.&lt;br&gt;• &lt;b&gt;Application Layer (RecipeService):&lt;/b&gt; Điều phối Use Cases, kích hoạt thẩm định điều kiện phát hành &lt;b&gt;[BR-01]&lt;/b&gt; (≥1 nguyên liệu, ≥1 bước SOP, sản lượng chuẩn), kiểm tra trạng thái hoạt động của nguyên liệu &lt;b&gt;[BR-07]&lt;/b&gt;, phát tán Audit Event qua Redis Streams.&lt;br&gt;• &lt;b&gt;Domain Layer (Recipe &amp;amp; RecipeVersion):&lt;/b&gt; Nơi giữ Nguồn Sự Thật (SSOT) về tính bất biến &lt;b&gt;[BR-04]&lt;/b&gt; (công thức Published không được phép sửa đè; muốn sửa phải fork thành Version mới). Snapshot tên và mã nguyên liệu để bảo toàn lịch sử pha chế.&lt;br&gt;• &lt;b&gt;Infrastructure Layer (RecipeRepository):&lt;/b&gt; Đóng gói câu lệnh truy vấn CSDL PostgreSQL theo chuẩn DB-First, quản lý giao dịch SaveChanges, hoàn toàn độc lập với UI.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;shadow=1;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="50" y="680" width="1180" height="120" as="geometry" />
    </mxCell>
  

