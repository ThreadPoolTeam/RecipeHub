        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    

      <mxCell id="e_recipe_db" value="Npgsql SQL (recipe_db)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ea580c;strokeWidth=1.8;fontColor=#0f172a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelPlacement=auto;" edge="1" parent="1" source="s_recipe" target="d_postgres">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    

      <mxCell id="e_identity_db" value="SQL (identity_db)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ea580c;strokeWidth=1.8;fontColor=#0f172a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelPlacement=auto;" edge="1" parent="1" source="s_identity" target="d_postgres">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    

      <mxCell id="e_worker_redis" value="XREADGROUP (Async)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ea580c;strokeWidth=1.8;fontColor=#0f172a;fontSize=10;fontStyle=1;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;labelPlacement=auto;" edge="1" parent="1" source="s_worker" target="d_redis">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    

      <mxCell id="e_worker_vol" value="Disk I/O (/app/temp-drafts)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ea580c;strokeWidth=1.8;fontColor=#0f172a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelPlacement=auto;" edge="1" parent="1" source="s_worker" target="d_volume">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    

      <mxCell id="e_content_cf" value="FLUX.1 Schnell REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9333ea;strokeWidth=1.8;fontColor=#0f172a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelPlacement=auto;" edge="1" parent="1" source="s_content" target="ext_cloudflare">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    

      <mxCell id="e_recipe_cld" value="HTTPS Upload (SDK)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9333ea;strokeWidth=1.8;fontColor=#0f172a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;labelPlacement=auto;" edge="1" parent="1" source="s_recipe" target="ext_cloudinary">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    

      <mxCell id="e_worker_cf" value="Worker Gen Ảnh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9333ea;strokeWidth=1.8;fontColor=#0f172a;fontSize=10;fontStyle=1;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;labelPlacement=auto;" edge="1" parent="1" source="s_worker" target="ext_cloudflare">
        <mxGeometry relative="1" as="geometry" />
