<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="RecipeHub System Design" version="24.0.0">
  <diagram id="recipehub-web-user-flow" name="RecipeHub Web User Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header Titles -->
        <mxCell id="title_block" value="HỆ THỐNG RECIPEHUB — ĐẶC TẢ USER FLOW TRÊN NỀN TẢNG WEB (NEXT.JS 16)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1917;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="35" as="geometry" />
        </mxCell>
        <mxCell id="subtitle_block" value="Phạm vi Web thuần túy (loại trừ mobile app): Xác thực &amp; Portal Hub, Không gian R&amp;D (Formula Lifecycle, Immutability v(N+1), AI Media, SOP PDF, Quiz), Vận hành Quầy Viewer (Tra cứu SOP, Thi trắc nghiệm), Quản trị Admin (Users, Health, Audit)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#706E68;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1600" height="25" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- SWIMLANE 1: AUTHENTICATION & PORTAL HUB     -->
        <!-- ========================================== -->
        <mxCell id="lane_auth" value="XÁC THỰC &amp; ĐIỀU HƯỚNG CHUNG (PUBLIC / AUTH / WORKSPACE HUB)" style="swimlane;horizontal=0;startSize=60;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#0f172a;html=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="2250" height="230" as="geometry" />
        </mxCell>

        <mxCell id="node_start" value="Bắt đầu:&lt;br&gt;Truy cập Web" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;strokeWidth=2;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_auth">
          <mxGeometry x="90" y="65" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="node_landing" value="Trang chủ Giới thiệu&lt;br&gt;&lt;b&gt;URL: /&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=12;fontStyle=0;align=center;shadow=1;" vertex="1" parent="lane_auth">
          <mxGeometry x="230" y="65" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="node_login" value="Đăng nhập hệ thống&lt;br&gt;&lt;b&gt;URL: /login&lt;/b&gt;&lt;br&gt;&lt;small&gt;(Email / Password)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=11;fontStyle=0;align=center;shadow=1;" vertex="1" parent="lane_auth">
