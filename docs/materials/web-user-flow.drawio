        <mxCell id="node_common_settings" value="Trang thông tin &amp; Cấu hình:&lt;br&gt;• &lt;b&gt;/profile&lt;/b&gt; (Hồ sơ cá nhân)&lt;br&gt;• &lt;b&gt;/settings&lt;/b&gt; (Tùy chọn hiển thị)&lt;br&gt;• &lt;b&gt;/help&lt;/b&gt; (Sổ tay hướng dẫn SOP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=11;fontStyle=0;align=left;spacingLeft=10;shadow=1;" vertex="1" parent="lane_auth">
