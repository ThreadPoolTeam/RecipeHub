<mxfile host="app.diagrams.net" agent="RecipeHub Conceptual ERD" version="24.0.0"><diagram id="recipehub-conceptual-erd" name="Conceptual ERD"><mxGraphModel dx="1700" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:22px'&gt;RecipeHub · Conceptual ERD&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#475569'&gt;17 thực thể nghiệp vụ · cardinality · nét đứt = tham chiếu mềm giữa service&lt;/span&gt;" style="text;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1590" height="60" as="geometry"/></mxCell><mxCell id="role" value="&lt;b&gt;ROLE&lt;/b&gt; · Vai trò&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Mã vai trò&lt;br&gt;• Tên vai trò&lt;br&gt;• 3 vai: admin, rnd, viewer&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="190" height="105" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;USER&lt;/b&gt; · Người dùng&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Họ tên&lt;br&gt;• Email&lt;br&gt;• Trạng thái tài khoản&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="320" y="285" width="190" height="105" as="geometry"/></mxCell><mxCell id="recipe" value="&lt;b&gt;RECIPE&lt;/b&gt; · Công thức&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Mã công thức&lt;br&gt;• Tên món&lt;br&gt;• Trạng thái lưu trữ&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="600" y="285" width="190" height="105" as="geometry"/></mxCell><mxCell id="ver" value="&lt;b&gt;RECIPE_VERSION&lt;/b&gt; · Phiên bản&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Số phiên bản&lt;br&gt;• Draft hoặc Published&lt;br&gt;• Sản lượng + đơn vị&lt;br&gt;• Ngày phát hành&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="880" y="285" width="190" height="105" as="geometry"/></mxCell><mxCell id="step" value="&lt;b&gt;STEP&lt;/b&gt; · Bước SOP&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Thứ tự&lt;br&gt;• Tiêu đề, mô tả&lt;br&gt;• Thời lượng&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1160" y="285" width="190" height="105" as="geometry"/></mxCell><mxCell id="media" value="&lt;b&gt;MEDIA_ASSET&lt;/b&gt; · Ảnh&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Nguồn: thật hoặc AI&lt;br&gt;• Tên tệp&lt;br&gt;• Trạng thái&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1440" y="285" width="190" height="105" as="geometry"/></mxCell><mxCell id="ai" value="&lt;b&gt;AI_IMAGE_DRAFT&lt;/b&gt; · Ảnh AI ứng viên&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Trạng thái&lt;br&gt;• Prompt&lt;br&gt;• Hết hạn sau 30 phút&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1440" y="120" width="190" height="105" as="geometry"/></mxCell><mxCell id="pdf" value="&lt;b&gt;PDF_DOCUMENT&lt;/b&gt; · Tài liệu PDF&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Loại: nháp, chính thức&lt;br&gt;• Phạm vi: đơn, bộ&lt;br&gt;• Trạng thái&lt;br&gt;• Mã hash&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff1f2;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="190" height="105" as="geometry"/></mxCell><mxCell id="ri" value="&lt;b&gt;RECIPE_INGREDIENT&lt;/b&gt; · Dòng nguyên liệu&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Định lượng&lt;br&gt;• Thứ tự&lt;br&gt;• Ghi chú&lt;br&gt;• Bước sử dụng&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="190" height="105" as="geometry"/></mxCell><mxCell id="ing" value="&lt;b&gt;INGREDIENT&lt;/b&gt; · Nguyên liệu&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Mã nguyên liệu&lt;br&gt;• Tên&lt;br&gt;• Cảnh báo&lt;br&gt;• Đang dùng&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="190" height="105" as="geometry"/></mxCell><mxCell id="ig" value="&lt;b&gt;INGREDIENT_GROUP&lt;/b&gt; · Nhóm&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Mã nhóm&lt;br&gt;• Tên nhóm&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="320" y="450" width="190" height="105" as="geometry"/></mxCell><mxCell id="unit" value="&lt;b&gt;UNIT&lt;/b&gt; · Đơn vị&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Mã đơn vị (g, ml)&lt;br&gt;• Nhóm đo&lt;br&gt;• Hệ số quy đổi&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="600" y="615" width="190" height="105" as="geometry"/></mxCell><mxCell id="qv" value="&lt;b&gt;QUIZ_VERSION&lt;/b&gt; · Phiên bản đề&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Số phiên bản&lt;br&gt;• Điểm đạt (mặc định 80)&lt;br&gt;• Draft, Published, Archived&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e0e7ff;strokeColor=#6366f1;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1160" y="450" width="190" height="105" as="geometry"/></mxCell><mxCell id="att" value="&lt;b&gt;QUIZ_ATTEMPT&lt;/b&gt; · Lượt làm bài&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Điểm&lt;br&gt;• Đạt hoặc không&lt;br&gt;• Đáp án đã chọn&lt;br&gt;• Thời gian làm&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e0e7ff;strokeColor=#6366f1;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1440" y="450" width="190" height="105" as="geometry"/></mxCell><mxCell id="quiz" value="&lt;b&gt;QUIZ&lt;/b&gt; · Bộ đề&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Mã bộ đề&lt;br&gt;• Tiêu đề&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e0e7ff;strokeColor=#6366f1;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1160" y="615" width="190" height="105" as="geometry"/></mxCell><mxCell id="qq" value="&lt;b&gt;QUIZ_QUESTION&lt;/b&gt; · Câu hỏi&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:10px;line-height:14px'&gt;• Nội dung&lt;br&gt;• 2 đến 6 lựa chọn&lt;br&gt;• 1 đáp án đúng&lt;br&gt;• Giải thích&lt;/div&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#e0e7ff;strokeColor=#6366f1;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1440" y="615" width="190" height="105" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;AUDIT_LOG&lt;/b&gt; · Nhật ký&lt;hr size='1' style='margin:3px 0'&gt;&lt;div align='left' style='font-size:1