t;/b&gt; Published versions are immutable; editing creates a new draft&lt;/td&gt;&lt;td width=50% valign=top&gt;&lt;b style='color:#b91c1c'&gt;BR-16&lt;/b&gt; AI images are candidates; only accepted ones become images&lt;br&gt;&lt;b style='color:#b91c1c'&gt;BR-21&lt;/b&gt; Official PDF comes only from a Published version&lt;br&gt;&lt;b style='color:#b91c1c'&gt;BR-23, 26&lt;/b&gt; Quiz tied to a Published version; pass when score ≥ 80&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=8;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="10" y="1300" width="2380" height="105" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=0;fontFamily=Helvetica;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="10" y="1425" width="44" height="26" as="geometry"/></mxCell><mxCell id="lt0" value="Entity" style="text;fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="60" y="1425" width="170" height="26" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rhombus;fontFamily=Helvetica;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="260" y="1425" width="44" height="26" as="geometry"/></mxCell><mxCell id="lt1" value="Relationship" style="text;fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="310" y="1425" width="170" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="" style="ellipse;fontFamily=Helvetica;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#10b981;" vertex="1" parent="1"><mxGeometry x="510" y="1425" width="44" height="26" as="geometry"/></mxCell><mxCell id="lt2" value="Attribute" style="text;fontFamily=Helvetica;