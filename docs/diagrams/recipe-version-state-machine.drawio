<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" compressed="false"><diagram id="recipe-version-state-machine" name="recipe-version-state-machine"><mxGraphModel dx="1500" dy="960" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title_banner" value="&lt;b&gt;Vòng đời phiên bản công thức&lt;/b&gt;&lt;br&gt;Chuyển trạng thái = Sự kiện [Điều kiện] / Hành động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;align=center;fontSize=15;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1408" height="55" as="geometry" /></mxCell>
<mxCell id="box_version" value="&lt;b&gt;Trạng thái Phiên bản công thức&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=13;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="35" y="95" width="898" height="415" as="geometry" /></mxCell>
<mxCell id="state_start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="217" width="32" height="36" as="geometry" /></mxCell>
<mxCell id="state_draft" value="&lt;b&gt;Bản nháp&lt;/b&gt;&lt;br&gt;(draft)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;fontColor=#1e3a8a;align=center;" vertex="1" parent="1"><mxGeometry x="246" y="195" width="167" height="80" as="geometry" /></mxCell>
<mxCell id="state_published" value="&lt;b&gt;Đã phát hành&lt;/b&gt;&lt;br&gt;(published)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontColor=#14532d;align=center;" vertex="1" parent="1"><mxGeometry x="713" y="195" width="176" height="80" as="geometry" /></mxCell>
<mxCell id="state_draft_next" value="&lt;b&gt;Bản nháp v(N+1)&lt;/b&gt;&lt;br&gt;(draft mới)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;fontColor=#1e3a8a;align=center;" vertex="1" parent="1"><mxGeometry x="475" y="385" width="185" height="80" as="geometry" /></mxCell>
<mxCell id="e_start_draft" value="Tạo công thức / tạo v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#1e3a8a;" edge="1" source="state_start" target="state_draft" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e_draft_self" value="Lưu chỉnh sửa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#1e3a8a;" edge="1" source="state_draft" target="state_draft" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="140" /><mxPoint x="370" y="140" /></Array></mxGeometry></mxCell>
<mxCell id="e_draft_pub" value="Phát hành" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;" edge="1" source="state_draft" target="state_published" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e_pub_next_draft" value="Chỉnh sửa / tạo nháp mới" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;" edge="1" source="state_published" target="state_draft_next" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="801" y="425" /></Array></mxGeometry></mxCell>
<mxCell id="box_recipe" value="&lt;b&gt;Công thức (không phải phiên bản — cột archived_at)&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontSize=13;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="959" y="95" width="484" height="415" as="geometry" /></mxCell>
<mxCell id="recipe_active" value="&lt;b&gt;Đang dùng&lt;/b&gt;&lt;br&gt;(archived_at = NULL)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontColor=#14532d;align=center;" vertex="1" parent="1"><mxGeometry x="990" y="195" width="163" height="80" as="geometry" /></mxCell>
<mxCell id="recipe_archived" value="&lt;b&gt;Lưu trữ&lt;/b&gt;&lt;br&gt;(archived_at có giá trị)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=13;fontColor=#334155;align=center;" vertex="1" parent="1"><mxGeometry x="1254" y="195" width="163" height="80" as="geometry" /></mxCell>
<mxCell id="e_recipe_archive" value="Lưu trữ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;" edge="1" source="recipe_active" target="recipe_archived" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1201" y="210" /></Array></mxGeometry></mxCell>
<mxCell id="e_recipe_restore" value="Khôi phục" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;" edge="1" source="recipe_archived" target="recipe_active" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1201" y="260" /></Array></mxGeometry></mxCell>
<mxCell id="note_recipe_archive" value="Ghi chú: Khi công thức Lưu trữ: không sửa,&lt;br&gt;không phát hành được (phải Khôi phục trước)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="990" y="370" width="427" height="80" as="geometry" /></mxCell>
<mxCell id="note_blocked" value="&lt;b&gt;Bị chặn:&lt;/b&gt;&lt;br&gt;• Phát hành khi thiếu sản lượng / nguyên liệu / bước → lỗi 400&lt;br&gt;• Phát hành một bản không phải Bản nháp → lỗi 409&lt;br&gt;• Đổi mã công thức sau lần phát hành đầu → lỗi 409&lt;br&gt;• Sửa hoặc phát hành khi công thức đã Lưu trữ → lỗi 409" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#991b1b;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="35" y="540" width="898" height="230" as="geometry" /></mxCell>
<mxCell id="note_db_constraints" value="&lt;b&gt;Ràng buộc ở CSDL:&lt;/b&gt;&lt;br&gt;• CHECK (status IN ('draft','published'))&lt;br&gt;• Unique index: mỗi công thức tối đa 1 Bản nháp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="959" y="540" width="484" height="230" as="geometry" /></mxCell>
<mxCell id="transition_details" value="&lt;b&gt;Chi tiết chuyển trạng thái&lt;/b&gt;&lt;br&gt;Phát hành: đủ sản lượng, nguyên liệu, các bước; ghi thời điểm, người phát hành và nhật ký.&lt;br&gt;Chỉnh sửa bản đã phát hành: tự tạo bản nháp mới; bản cũ giữ nguyên." style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontColor=#172B3A;fillColor=#F3F7FA;strokeColor=#748A9A;align=center;verticalAlign=middle;spacing=5;fillColor=#FFF7DD;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="35" y="800" width="1408" height="100" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
