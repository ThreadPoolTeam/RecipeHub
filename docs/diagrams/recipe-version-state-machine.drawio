<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="RecipeHub State Machine" version="24.0.0">
  <diagram id="recipehub-state-machine" name="Vòng đời phiên bản công thức">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title_banner" value="&lt;b&gt;Vòng đời phiên bản công thức&lt;/b&gt;&lt;br&gt;Chuyển trạng thái = Sự kiện [Điều kiện] / Hành động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;align=center;fontSize=15;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="55" as="geometry" />
        </mxCell>

        <mxCell id="box_version" value="&lt;b&gt;Trạng thái Phiên bản công thức&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=13;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1020" height="415" as="geometry" />
        </mxCell>

        <mxCell id="state_start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="80" y="217" width="36" height="36" as="geometry" />
        </mxCell>

        <mxCell id="state_draft" value="&lt;b&gt;Bản nháp&lt;/b&gt;&lt;br&gt;(draft)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;fontColor=#1e3a8a;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="195" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="state_published" value="&lt;b&gt;Đã phát hành&lt;/b&gt;&lt;br&gt;(published)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontColor=#14532d;align=center;" vertex="1" parent="1">
          <mxGeometry x="810" y="195" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="state_draft_next" value="&lt;b&gt;Bản nháp v(N+1)&lt;/b&gt;&lt;br&gt;(draft mới)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;fontColor=#1e3a8a;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="385" width="210" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e_start_draft" value="Tạo công thức / tạo v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;whiteSpace=wrap;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_start" target="state_draft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_draft_self" value="Lưu chỉnh sửa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;whiteSpace=wrap;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_draft" target="state_draft">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="140" />
              <mxPoint x="420" y="140" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_draft_pub" value="Phát hành [đủ sản lượng, nguyên liệu, các bước]&lt;br&gt;/ ghi thời điểm, người phát hành, nhật ký" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;whiteSpace=wrap;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_draft" target="state_published">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_pub_next_draft" value="Chỉnh sửa / tự tạo bản nháp mới,&lt;br&gt;bản cũ giữ nguyên" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;whiteSpace=wrap;dashed=1;dashPattern=6 4;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state_published" target="state_draft_next">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="910" y="425" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="box_recipe" value="&lt;b&gt;Công thức (không phải phiên bản — cột archived_at)&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontSize=13;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1090" y="95" width="550" height="415" as="geometry" />
        </mxCell>

        <mxCell id="recipe_active" value="&lt;b&gt;Đang dùng&lt;/b&gt;&lt;br&gt;(archived_at = NULL)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontColor=#14532d;align=center;" vertex="1" parent="1">
          <mxGeometry x="1125" y="195" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="recipe_archived" value="&lt;b&gt;Lưu trữ&lt;/b&gt;&lt;br&gt;(archived_at có giá trị)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=13;fontColor=#334155;align=center;" vertex="1" parent="1">
          <mxGeometry x="1425" y="195" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e_recipe_archive" value="Lưu trữ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;whiteSpace=wrap;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recipe_active" target="recipe_archived">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1365" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_recipe_restore" value="Khôi phục" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;whiteSpace=wrap;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recipe_archived" target="recipe_active">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1365" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note_recipe_archive" value="Ghi chú: Khi công thức Lưu trữ: không sửa,&lt;br&gt;không phát hành được (phải Khôi phục trước)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="1125" y="370" width="485" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note_blocked" value="&lt;b&gt;Bị chặn:&lt;/b&gt;&lt;br&gt;• Phát hành khi thiếu sản lượng / nguyên liệu / bước → lỗi 400&lt;br&gt;• Phát hành một bản không phải Bản nháp → lỗi 409&lt;br&gt;• Đổi mã công thức sau lần phát hành đầu → lỗi 409&lt;br&gt;• Sửa hoặc phát hành khi công thức đã Lưu trữ → lỗi 409" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#991b1b;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1020" height="230" as="geometry" />
        </mxCell>

        <mxCell id="note_db_constraints" value="&lt;b&gt;Ràng buộc ở CSDL:&lt;/b&gt;&lt;br&gt;• CHECK (status IN ('draft','published'))&lt;br&gt;• Unique index: mỗi công thức tối đa 1 Bản nháp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="540" width="550" height="230" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
